{
  "jupyter-lite-schema-version": 0,
  "jupyter-config-data": {
    "appName": "PyLabRobot REPL",
    "appUrl": "./lab",
    "contentsStorageName": "praxis-repl-contents",
    "settingsStorageName": "praxis-repl-settings",
    "workspacesStorageName": "praxis-repl-workspaces",
    "exposeAppInBrowser": "true",
    "disabledExtensions": [
      "@jupyterlab/apputils-extension:announcements"
    ],
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "disablePyPIFallback": true
      }
    }
  }
}
